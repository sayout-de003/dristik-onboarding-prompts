# ==============================================================================
# Dristik AI — Production Environment Configuration Template (.env.example)
# ==============================================================================

# Core System Environment
ENVIRONMENT=production
DEBUG=false
PRODUCTION_DATA_INTEGRITY_MODE=true
APP_NAME=Dristik AI
APP_VERSION=2.0.0

# Exposed Host Ports
FRONTEND_PORT=5173
BACKEND_PORT=8000

# ==============================================================================
# 1. Platform Infrastructure & Encryption (Critical for Tenant Isolation)
# ==============================================================================
# Master secret for HMAC-signing user sessions, SSO state, and deriving AES-GCM encryption keys.
# MUST be a 32+ character high-entropy random string in production!
AUTH_SECRET=
# Dedicated AES-256 key for encrypting customer OAuth tokens and API keys in external_connections
EXTERNAL_INTEGRATION_ENCRYPTION_KEY=
# SQLite DB paths (or Postgres connection URIs in high-concurrency environments)
AUTH_DATABASE_PATH=data/dristik.db
EXTERNAL_AUTHORITY_DB_PATH=data/external_authority.db
SESSION_DAYS=14
# Frontend domain where tenants are redirected after OAuth completion
FRONTEND_URL=http://localhost:5173

SYSTEM_ADMIN_EMAIL=admin@dristik.ai
SYSTEM_ADMIN_PASSWORD=
SYSTEM_ADMIN_NAME=Dristik Admin

# ==============================================================================
# 2. User Authentication & 1-Click SSO (Google & GitHub)
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==============================================================================
# 3. SEO, Search Console & Analytics Connectors
# ==============================================================================
# Universal OAuth Redirect Endpoints
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connectors/oauth/callback
EXTERNAL_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/external-authority/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/connectors/google/oauth/callback

# Google Search Console, GA4 & Business Profile
GSC_ENABLED=true
GA4_ENABLED=true
GBP_ENABLED=true
GSC_URL_INSPECTION_ENABLED=false

# Google Chrome UX Report (CrUX) API Key
CRUX_API_KEY=

# Bing Webmaster Tools
BING_WEBMASTER_ENABLED=true
BING_OAUTH_CLIENT_ID=
BING_OAUTH_CLIENT_SECRET=
BING_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/external-authority/oauth/callback
BING_OAUTH_SCOPE=offline_access https://ssl.bing.com/webmaster/api/.default

# DataForSEO v3 (SERP & Backlink Intelligence)
DATAFORSEO_ENABLED=true
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Ahrefs API v3
AHREFS_ENABLED=true
AHREFS_CLIENT_ID=
AHREFS_CLIENT_SECRET=
AHREFS_API_KEY=

# Semrush Authority API
SEMRUSH_ENABLED=true
SEMRUSH_CLIENT_ID=
SEMRUSH_CLIENT_SECRET=
SEMRUSH_API_KEY=

# Majestic SEO Flow Metrics
MAJESTIC_ENABLED=true
MAJESTIC_API_KEY=

# ==============================================================================
# 4. CMS & Code Remediation Connectors
# ==============================================================================
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WORDPRESS_CLIENT_ID=
WORDPRESS_CLIENT_SECRET=

# ==============================================================================
# 5. CRM & Revenue Attribution Connectors
# ==============================================================================
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=

# ==============================================================================
# 6. Social Distribution & Messaging Connectors
# ==============================================================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
WHATSAPP_BUSINESS_CLIENT_ID=
WHATSAPP_BUSINESS_CLIENT_SECRET=

# ==============================================================================
# 7. AI Ingestion, Citation Models & Crawler
# ==============================================================================
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o

OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://dristik.ai
OPENROUTER_SITE_NAME=Dristik AI
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
TOGETHER_API_KEY=

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/e5-small-v2
EMBEDDING_DEVICE=cpu
HF_TOKEN=

PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=15000
MAX_CRAWL_PAGES=5
CRAWL_TIMEOUT_SECONDS=15
CRAWL_CONCURRENCY=3
FIRECRAWL_API_KEY=

# ==============================================================================
# 8. Commercial Billing (Razorpay)
# ==============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
